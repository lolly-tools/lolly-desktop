[Desktop Entry]
Type=Application
Name=Lolly
Comment=Generate on-brand creative assets from simple inputs
# Exec is the in-sandbox command; Flatpak rewrites it to `flatpak run tools.lolly.Desktop`
# in the exported host entry. Icon name matches the installed hicolor icon (the app id).
Exec=lolly-desktop
Icon=tools.lolly.Desktop
Terminal=false
Categories=Graphics;2DGraphics;
Keywords=brand;design;qr;svg;pdf;chart;template;
# The canonical .lolly MIME (LOLLY_MIME in shells/web/src/lib/lolly-pack.ts, registered
# by ../linux/mime/tools.lolly.Desktop.xml), plus SVG open-with and the lolly:// deep
# link - the URL after the scheme is exactly a lolly.tools URL path (URL-mode contract).
MimeType=application/vnd.lolly+zip;image/svg+xml;x-scheme-handler/lolly;
Actions=new-qr;colour-lab;strip-data;

# Desktop actions ride the same deep-link route as x-scheme-handler/lolly above - the
# argv parser classifies lolly://* and navigates, so a verb here is just a frozen URL.
[Desktop Action new-qr]
Name=New QR code
Exec=lolly-desktop lolly://tool/qr-code
Icon=tools.lolly.Desktop

[Desktop Action colour-lab]
Name=Open Colour Lab
Exec=lolly-desktop lolly://lab
Icon=tools.lolly.Desktop

[Desktop Action strip-data]
Name=Strip hidden data
Exec=lolly-desktop lolly://tool/strip-data
Icon=tools.lolly.Desktop
