<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metainfo. The component id MUST equal the Flatpak app id, and the
     launchable MUST equal the installed .desktop file name, or `appstreamcli compose`
     (run by flatpak-builder) will drop the app from the catalog. -->
<component type="desktop-application">
  <id>tools.lolly.Desktop</id>
  <name>Lolly</name>
  <summary>Generate on-brand creative assets from simple inputs</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>

  <developer id="tools.lolly">
    <name>Lolly</name>
  </developer>

  <description>
    <p>
      Lolly is a constraint-first, template-driven tool for generating on-brand
      creative assets - QR codes, charts, diagrams, event badges, documents, filters
      and more - as PNG, SVG, PDF or video. Everything renders on your device; nothing
      is uploaded.
    </p>
  </description>

  <launchable type="desktop-id">tools.lolly.Desktop.desktop</launchable>

  <!-- Software-center polish. Branding colours are the brand greens the app ships
       (light: the primary green; dark: the deep pine the dark theme grounds on) -
       GNOME Software paints the banner with these. Categories mirror the .desktop's
       Categories=; keywords extend its Keywords= for store search. -->
  <branding>
    <color type="primary" scheme_preference="light">#30ba78</color>
    <color type="primary" scheme_preference="dark">#0c322c</color>
  </branding>

  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
  </categories>

  <keywords>
    <keyword>brand</keyword>
    <keyword>design</keyword>
    <keyword>qr</keyword>
    <keyword>svg</keyword>
    <keyword>pdf</keyword>
    <keyword>chart</keyword>
    <keyword>template</keyword>
    <keyword>badge</keyword>
    <keyword>poster</keyword>
  </keywords>

  <!-- What the package integrates with, machine-readably: the .lolly bundle type
       (linux/mime/tools.lolly.Desktop.xml) and the automation bus name the running
       app owns (linux/search/org.lolly.Desktop1.service). -->
  <provides>
    <mediatype>application/vnd.lolly+zip</mediatype>
    <dbus type="user">org.lolly.Desktop1</dbus>
  </provides>

  <!-- Captured from the app's own documentation shots (docs/shots), rasterised
       from the vector originals. Served from this repo on `main`, which is what
       AppStream needs: an absolute, publicly reachable URL. -->
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/lolly-tools/lolly-desktop/main/flatpak/flathub/screenshots/gallery.png</image>
      <caption>The tool gallery - every tool is data, not bundled code</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lolly-tools/lolly-desktop/main/flatpak/flathub/screenshots/utilities.png</image>
      <caption>Utilities for everyday jobs: verify, unpack, convert, capture</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lolly-tools/lolly-desktop/main/flatpak/flathub/screenshots/brand-studio.png</image>
      <caption>The brand studio - colours, type and tokens define what every tool renders</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lolly-tools/lolly-desktop/main/flatpak/flathub/screenshots/export.png</image>
      <caption>Export to PNG, SVG, PDF or video, rendered on your device</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />

  <url type="homepage">https://lolly.tools</url>

  <releases>
    <release version="1.0.0" date="2026-08-29">
      <description>
        <p>
          First packaged release: the full tool gallery and brand studio, on-device
          export to PNG, SVG, PDF and video, and Linux desktop integration - .lolly
          files open (and thumbnail) from the file manager, lolly:// links deep-link
          into tools, and GNOME Shell search finds tools by name.
        </p>
      </description>
    </release>
  </releases>
</component>
