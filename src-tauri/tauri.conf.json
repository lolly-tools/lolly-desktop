{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lolly",
  "version": "1.0.1",
  "identifier": "tools.lolly.Desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lolly",
        "width": 1200,
        "height": 800,
        "minWidth": 300,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "lolly"
        ],
        "mimeType": "application/vnd.lolly+zip",
        "description": "Lolly bundle (session share or brand pack)",
        "name": "lolly",
        "role": "Editor"
      }
    ]
  }
}
